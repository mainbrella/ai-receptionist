{
  "name": "@mainbrella/ai-receptionist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "npm run build:client && wrangler dev",
    "build:client": "vite build",
    "build": "npm run typecheck && npm run build:client && wrangler deploy --dry-run --outdir dist/worker",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.client.json",
    "test": "tsx --test test/*.test.ts src/*.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build:client && wrangler deploy",
    "catalog:manifest": "node scripts/catalog-manifest.mjs"
  },
  "dependencies": {
    "@cloudflare/voice": "0.5.0",
    "agents": "0.28.1",
    "twilio": "5.13.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260922.1",
    "@types/node": "22.20.5",
    "esbuild": "0.28.1",
    "miniflare": "5.20260921.0-alpha",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "wrangler": "4.136.2"
  }
}
